{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scroll Academy",
  "version": "1.1.0",
  "identifier": "app.scrollacademy.bible",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run desktop:prepare",
    "frontendDist": "http://127.0.0.1:3313"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Scroll Academy — Gamified Bible Study",
        "width": 1280,
        "height": 860,
        "minWidth": 390,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/server/", "resources/scroll.db"],
    "externalBin": ["binaries/bun"],
    "category": "Education",
    "shortDescription": "Duolingo-style gamified Bible study — fully offline",
    "longDescription": "Learn Biblical Greek, Biblical Hebrew, manuscript history, apologetics, metaphysics and the arguments for God with streaks, XP, hearts, gems, leagues, daily quests, story mode and achievements. The whole app — including the Bible text — runs locally on your machine with no internet required. 100% free and open-source."
  }
}

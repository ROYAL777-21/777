generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
//  USER & PROGRESS
// ─────────────────────────────────────────────────────────────

model User {
  id        String   @id @default("user_1")
  name      String   @default("Scribe")
  image     String   @default("🦁")
  avatar    String?  // JSON AvatarConfig (SVG avatar system)
  bio       String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress         UserProgress?
  completions      LessonCompletion[]
  challengeRecords ChallengeProgress[]
  achievements     UserAchievement[]
  quests           UserQuest[]
  items            UserItem[]
  notifications    AppNotification[]
  bibleReads       BibleRead[]
  verseMarks       VerseMark[]
  planProgress     PlanProgress[]
  posts            Post[]
  comments         PostComment[]
  storyCompletions StoryCompletion[]
  dailyQuiz        DailyQuizCompletion[]
  emails           EmailLog[]
  engineEvents     EngineEvent[]
  engineSnapshots  EngineSnapshot[]
  engineInterventions EngineIntervention[]
  referral         Referral?
}

model UserProgress {
  id             String  @id @default(cuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeCourseId String?
  activeCourse   Course? @relation(fields: [activeCourseId], references: [id])

  hearts           Int      @default(5)
  gems             Int      @default(500)
  xp               Int      @default(0)
  streak           Int      @default(0)
  streakFreezes    Int      @default(0)
  lastActiveDay    String?  // "2026-10-29" date key of last completed lesson
  doubleXpUntil    DateTime?
  lastHeartAt      DateTime? // last heart-regeneration anchor

  // ── Today's Manna (v11.5 — the daily clock mechanic) ──
  // Fresh portion every morning (Exodus 16): a daily verse to gather on the
  // path. Collecting keeps the manna streak; a new portion lands at midnight.
  mannaStreak   Int     @default(0) // consecutive days the portion was gathered
  lastMannaDay  String? // day key of the last gathered portion

  // ── Daily goal agency (v11.5 — the streak-trap antidote) ──
  // NULL = the engine sizes the goal to the habit stage; a value is the
  // learner's own choice (Casual 20 · Steady 50 · Scholar 100).
  dailyGoal     Int?
  leagueId         String?
  leagueOrder      Int      @default(0) // current league tier index
  lastWeekKey      String?  // week the user last competed in
  dailyXp          Int      @default(0) // xp earned today
  dailyXpDay       String?
  soundOn          Boolean  @default(true)
  hapticsOn        Boolean  @default(true)
  likedPosts       String   @default("[]") // JSON array of post ids the user liked

  // ── plan & entitlements (Scroll Pro) ──
  plan             String   @default("free") // free | pro | lifetime
  planSince        DateTime?
  trialEndsAt      DateTime?
  lastProFreezeGrant String? // "2026-11" month key of the last monthly Pro Streak Repair grant
  lastCanceledAt   DateTime? // when Pro was cancelled/paused — drives the winback journey

  // ── notification & email preferences ──
  reminderTime     String   @default("19:00") // HH:mm local — daily study reminder
  quietHoursOn     Boolean  @default(true) // 21:00–08:00 suppress non-critical pushes
  notifPrefs       String   @default("{}") // JSON map: type -> enabled
  emailPrefs       String   @default("{}") // JSON map: journey -> enabled
  emailOptIn       Boolean  @default(true)
  lastNotifEvalAt  DateTime?
  lastEmailEvalAt  DateTime?

  // ── engine & reader preferences ──
  personalizedOffers Boolean @default(true) // trust toggle: engine may time offers to momentum
  redLetterOn        Boolean @default(true) // words of God/Christ shown in red

  // ── referral program (give-a-month-get-a-month growth loop) ──
  referralProMonths  Int     @default(0) // banked free Pro months from referral conversions

  updatedAt        DateTime @updatedAt
}

// ── Referral program ──────────────────────────────────────────
// One row per user: their share code + share counters.
model Referral {
  id         String   @id @default(cuid())
  code       String   @unique // 6-char share code (random at creation — never enumerable)
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shares     Int      @default(0) // lifetime link shares/copies tracked
  sharesDay  String   @default("") // day key of the daily share counter ("" = never)
  sharesToday Int     @default(0) // shares today (resets when sharesDay rolls over)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Ledger of friends who joined via a referral code (one row per friend).
model ReferralInvite {
  id         String    @id @default(cuid())
  refCode    String // referral code used by the friend
  friendName String    @default("a friend") // display label (sandbox: generated handle)
  status     String    @default("joined") // joined | subscribed
  joinedAt   DateTime  @default(now())
  rewardedAt DateTime? // when the referrer reward was granted
  rewardKind String    @default("") // join_gems | pro_month
  note       String    @default("") // human-readable reward description
  createdAt  DateTime  @default(now())

  @@index([refCode, createdAt])
}

// A milestone rung (1·3·5·10 joins) can be granted EXACTLY once per code —
// the unique key makes duplicate awards structurally impossible (race-proof).
model ReferralMilestoneGrant {
  id        String   @id @default(cuid())
  refCode   String
  joins     Int // the rung: 1 | 3 | 5 | 10
  kind      String // gems | freezes | pro
  grantedAt DateTime @default(now())

  @@unique([refCode, joins])
}

// email journey delivery log (provider-agnostic: sandbox simulates send)
model EmailLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  journey     String // welcome_series | streak_saver | re_engagement | weekly_digest | milestone | pro_offer | winback | pro_welcome
  step        String
  subject     String
  preheader   String   @default("")
  bodyText    String
  ctaLabel    String?
  ctaView     String?
  status      String   @default("sent") // sent | skipped
  sentAt      DateTime @default(now())

  @@unique([userId, journey, step])
}

// ─────────────────────────────────────────────────────────────
//  CURRICULUM
// ─────────────────────────────────────────────────────────────

model Course {
  id          String  @id @default(cuid())
  code        String  @unique // "greek" | "hebrew" | "manuscripts" | "apologetics"
  title       String
  subtitle    String
  description String
  emoji       String
  color       String  // hex accent
  order       Int
  units       Unit[]
  activeFor   UserProgress[]
}

model Unit {
  id          String  @id @default(cuid())
  courseId    String
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String
  emoji       String
  color       String
  order       Int
  difficulty  Int     @default(1) // 1 Foundations · 2 Growing · 3 Advanced (timed challenges)
  // JSON: { inApp, outsideApp, routine } — growth tips shown in the guidebook
  tipsJson    String?
  lessons     Lesson[]
}

model Lesson {
  id         String   @id @default(cuid())
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title      String
  order      Int
  challenges Challenge[]
  completions LessonCompletion[]
}

// type: INFO | SELECT | ASSIST | MATCH | ARRANGE | TYPE
model Challenge {
  id              String   @id @default(cuid())
  lessonId        String
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type            String
  prompt          String   // instruction shown above the exercise
  question        String   // main content / term / statement
  meaning         String?  // feedback / explanation shown after answering
  transliteration String?  // latin-letter reading (logos, shalom…)
  order           Int
  options         ChallengeOption[]
  records         ChallengeProgress[]
}

model ChallengeOption {
  id         String    @id @default(cuid())
  challengeId String
  challenge  Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  text       String
  correct    Boolean   @default(false)
  order      Int
  matchId    String?   // MATCH: pair key
  wordOrder  Int?      // ARRANGE: correct position of this word
}

model LessonCompletion {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  xpEarned     Int
  comboMax     Int
  accuracy     Int
  durationSec  Int
  completedAt  DateTime @default(now())

  @@unique([userId, lessonId])
}

model ChallengeProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  mistakes    Int       @default(0)

  @@unique([userId, challengeId])
}

// ─────────────────────────────────────────────────────────────
//  GAMIFICATION
// ─────────────────────────────────────────────────────────────

model Quest {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  description String
  icon        String
  metric      String // xp | lessons | combo | perfect | correct
  target      Int
  gemsReward  Int    @default(15)
  userQuests  UserQuest[]
}

model UserQuest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId   String
  quest     Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)
  day       String   // date key
  progress  Int      @default(0)
  completed Boolean  @default(false)
  claimed   Boolean  @default(false)

  @@unique([userId, questId, day])
}

model League {
  id     String @id @default(cuid())
  name   String // Bronze … Diamond
  emoji  String
  order  Int
  color  String
  entries LeagueEntry[]
}

model LeagueEntry {
  id           String  @id @default(cuid())
  leagueId     String
  league       League  @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  weekKey      String  // "2026-W44"
  userId       String  @default("user_1")
  displayName  String
  avatarEmoji  String  @default("📖")
  targetXp     Int     @default(0) // bots: weekly goal; user: live xp
  xp           Int     @default(0)
  isBot        Boolean @default(false)
  isCurrentUser Boolean @default(false)

  @@unique([leagueId, weekKey, displayName])
}

model Achievement {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  description String
  icon        String
  metric      String // streak | xp | lessons | perfect | challenges | quests | courses
  tiers       String // JSON int[]
  tierNames   String // JSON string[]
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  tier          Int         @default(0)
  unlockedAt    DateTime?

  @@unique([userId, achievementId])
}

model StoreItem {
  id          String @id @default(cuid())
  slug        String @unique // streak_freeze | heart_refill | double_xp
  name        String
  description String
  icon        String
  price       Int
  userItems   UserItem[]
}

model UserItem {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId   String
  item     StoreItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity Int       @default(0)

  @@unique([userId, itemId])
}

model ChestClaim {
  id        String   @id @default(cuid())
  userId    String
  unitId    String
  claimedAt DateTime @default(now())

  @@unique([userId, unitId])
}

// ─────────────────────────────────────────────────────────────
//  DAILY QUIZ (Bible knowledge, 5 questions per day)
// ─────────────────────────────────────────────────────────────

model DailyQuizCompletion {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       String // "2026-10-30"
  score     Int
  total     Int
  xpEarned  Int
  createdAt DateTime @default(now())

  @@unique([userId, day])
}

model AppNotification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // welcome | streak_risk | streak_saved | quest | achievement | league | reminder | info | friend | social
  title     String
  body      String
  icon      String   @default("🔔")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
//  BIBLE READER
// ─────────────────────────────────────────────────────────────

model BibleRead {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String   // "gen" … "rev"
  chapter   Int
  readAt    DateTime @default(now())

  @@unique([userId, bookId, chapter])
}

// one mark per verse: color "" = bookmark only
model VerseMark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String
  chapter   Int
  verse     Int
  color     String   @default("gold") // gold | rose | teal | violet | bookmark
  note      String   @default("")
  createdAt DateTime @default(now())

  @@unique([userId, bookId, chapter, verse])
}

// reading-plan day check-offs (plan definitions live in code)
model PlanProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId      String
  day         Int
  completedAt DateTime @default(now())

  @@unique([userId, planId, day])
}

// ─────────────────────────────────────────────────────────────
//  STORY MODE (dialogue-based scenarios)
// ─────────────────────────────────────────────────────────────

model Story {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  description String
  emoji       String
  color       String
  category    String // bible | apologetics | history | languages
  difficulty  Int               @default(1) // 1 easy · 2 medium · 3 hard
  xpReward    Int               @default(20)
  order       Int
  // JSON map: speaker name -> emoji (the cast list)
  castJson    String            @default("{}")
  scenes      StoryScene[]
  completions StoryCompletion[]
}

model StoryScene {
  id           String @id @default(cuid())
  storyId      String
  story        Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  order        Int
  kind         String // NARRATION | LINE | QUESTION
  speaker      String? // LINE only — cast member name
  text         String
  // QUESTION fields:
  question     String?
  optionsJson  String @default("[]") // JSON string[]
  correctIndex Int    @default(0)
  meaning      String? // explanation shown after answering
}

model StoryCompletion {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyId     String
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  xpEarned    Int
  perfect     Boolean  @default(false)
  completedAt DateTime @default(now())

  @@unique([userId, storyId])
}

// ─────────────────────────────────────────────────────────────
//  COMMUNITY & FRIENDS
// ─────────────────────────────────────────────────────────────

model BotUser {
  id          String  @id // "bot_1" …
  name        String
  avatar      String  // JSON AvatarConfig
  bio         String  @default("")
  country     String  @default("🌍")
  streak      Int     @default(0)
  weeklyXp    Int     @default(0)
  isFriend    Boolean @default(false)
  requestedByUser Boolean @default(false) // outgoing request pending
  requestedToUser Boolean @default(false) // incoming request pending
  requestedAt DateTime?

  posts       Post[]
  comments    PostComment[]
}

model Post {
  id          String        @id @default(cuid())
  authorBotId String?
  bot         BotUser?      @relation(fields: [authorBotId], references: [id], onDelete: Cascade)
  user        User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String?
  body        String
  // JSON card: { kind: achievement|streak|verse|plan|course, title, subtitle, icon, color }
  attachment  String?
  likes       Int           @default(0)
  createdAt   DateTime      @default(now())
  comments    PostComment[]
}

model PostComment {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorBotId String?
  bot         BotUser? @relation(fields: [authorBotId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String?
  body        String
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
//  CHURCH PLANS (B2B) — org seats + the admin dashboard feed
//  REVENUE.md §6 weeks 3–6: the 10-church pilot program
// ─────────────────────────────────────────────────────────────

model ChurchOrg {
  id           String   @id @default(cuid())
  slug         String   @unique // "grace-community"
  name         String // "Grace Community Church"
  city         String   @default("")
  // fifty (≤50 seats, $99/mo) | twohundred (≤250 seats, $299/mo) | network (1,000+ seats, $1,999/mo)
  tier         String   @default("fifty")
  seatsTotal   Int      @default(50)
  priceMonthly Int      @default(99) // USD / month, whole org
  contactName  String   @default("")
  contactEmail String   @default("")
  // the study focus chosen at sign-up — shown on the dashboard header
  focusCourse  String   @default("biblical-greek")
  startedAt    DateTime @default(now())
  renewalAt    DateTime // next billing date
  members      ChurchMember[]
}

// One seat per enrolled learner. userId is set for the admin (user_1) so the
// dashboard can render their live stats; pilot-cohort members carry their
// stored weekly snapshot (the sandbox's simulated congregation).
model ChurchMember {
  id        String   @id @default(cuid())
  orgId     String
  org       ChurchOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // null for the pilot cohort; "user_1" for the admin seat (live stats)
  userId    String?
  name      String
  emoji     String   @default("📖")
  role      String   @default("member") // admin | member
  joinedAt  DateTime @default(now())

  // stored cohort stats (pilot members). For the admin seat these are
  // recomputed live from LessonCompletion / BibleRead / UserProgress.
  lessons      Int  @default(0)
  chaptersRead Int  @default(0) // verse coverage
  streak       Int  @default(0)
  weeklyXp     Int  @default(0)
  lastActiveDaysAgo Int @default(0) // 0 = today

  // JSON: last 8 weeks [{ lessons, chapters, xp }] — the cohort trend chart
  weeksJson String   @default("[]")

  @@index([orgId])
}

// ─────────────────────────────────────────────────────────────
//  GIFT SUBSCRIPTIONS — the checkout order bump
//  REVENUE.md §6 weeks 7–10: "Gift a year — $39.99" at checkout
// ─────────────────────────────────────────────────────────────

model GiftCode {
  id            String    @id @default(cuid())
  // SCROLL-XXXX-XXXX (crypto-random, shown once at purchase)
  code          String    @unique
  months        Int       @default(12) // a gifted year of Scroll Pro
  fromName      String    @default("") // "To: Naomi — happy birthday"
  message       String    @default("") // ≤140 chars, shown at redeem
  pricePaidCents Int      @default(3999) // $39.99 order-bump price
  purchasedBy   String    @default("user_1")
  purchasedAt   DateTime  @default(now())
  // the one-time claim: null until redeemed (updateMany-guarded, race-proof)
  redeemedBy    String?
  redeemedAt    DateTime?
  redeemedName  String    @default("") // display name at redemption time

  @@index([purchasedBy])
}

model EngineEvent {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    String // app_open | view_change | lesson_complete | paywall_view | pro_activate | …
  payload String   @default("{}") // JSON, small — validated against src/lib/telemetry/schema.ts
  sv      Int      @default(11) // telemetry schema version that wrote this event
  ts      DateTime @default(now())

  @@index([userId, ts])
  @@index([userId, type, ts])
}

model EngineSnapshot {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version      Int      @default(1)
  featureCount Int      @default(0)
  gameCount    Int      @default(0)
  state        String // JSON: { features:{id:v}, scores, game, insights, segment }
  computedAt   DateTime @default(now())

  @@index([userId, computedAt])
}

model EngineModel {
  id         String   @id @default(cuid())
  name       String   @unique // churn | conversion | notification_open | adaptive
  version    Int      @default(1)
  weights    String   @default("{}") // JSON { featureId: weight }
  bias       Float    @default(0)
  metrics    String   @default("{}") // JSON { auc, samples, holdoutAuc, note, … }
  sampleSize Int      @default(0)
  trainedAt  DateTime @default(now())
}

model EngineIntervention {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String // study_nudge | review_quest | social_connect | streak_protect | paywall_invite | winback_offer | goal_adjust | course_suggest | rest_encourage | celebrate
  variant    String    @default("") // bandit arm / copy tone variant
  channel    String    @default("in_app") // in_app | notification | email
  segment    String    @default("default")
  snapshotId String?
  reason     String    @default("") // human-readable decision rationale (transparency)
  status     String    @default("planned") // planned | shown | converted | dismissed | expired
  outcome    String    @default("{}") // JSON: { event, at, … }
  utility    Float     @default(0) // expected-utility estimate at decision time
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  shownAt    DateTime?
  resolvedAt DateTime?

  @@index([userId, kind, status])
  @@index([userId, createdAt])
}

model EngineBandit {
  id        String   @id @default(cuid())
  context   String // paywall_hook | nudge_tone | quest_mix | reward_boost | winback_depth | digest_day
  arm       String
  alpha     Float    @default(1) // Beta posterior — successes
  beta      Float    @default(1) // Beta posterior — failures
  exposures Int      @default(0)
  converts  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([context, arm])
}
